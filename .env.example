# ============================================================
# CineMind environment configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NOTE: Only the CHATBOT uses an external AI API (Groq). Movie
# search, recommendations, details and posters all come from local
# files in the models/ folder.
# ============================================================

# --- Chatbot AI provider: Groq (official `groq` Python SDK) ---
# Get a free API key at https://console.groq.com/keys
# Leave GROQ_API_KEY empty to use the chatbot's basic local fallback replies.
GROQ_API_KEY=

# Groq-hosted chat model id. Default is a current Groq *production* model
# (see https://console.groq.com/docs/models). Override only if you need to.
GROQ_MODEL=llama-3.3-70b-versatile

# Optional advanced settings:
#   GROQ_BASE_URL  Override the Groq API base URL (defaults to the SDK's
#                  own endpoint; set only for a proxy/self-hosted gateway).
#   GROQ_TIMEOUT   Per-request timeout in seconds (default 30).
# GROQ_BASE_URL=
GROQ_TIMEOUT=30

# --- Backward compatibility (deprecated) ---
# Older CineMind versions used AI_API_KEY / AI_MODEL. They are still read as
# fallbacks when the GROQ_* variables above are unset, but please migrate:
#   AI_API_KEY  ->  GROQ_API_KEY
#   AI_MODEL    ->  GROQ_MODEL
# AI_API_KEY=
# AI_MODEL=

# --- Server ---
HOST=127.0.0.1
PORT=8000
