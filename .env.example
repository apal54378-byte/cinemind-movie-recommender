# ============================================================
# CineMind environment configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NOTE: Only the CHATBOT uses an external AI API. Movie search,
# recommendations, details and posters all come from local files
# in the models/ folder.
# ============================================================

# --- Chatbot AI provider (OpenAI-compatible) ---
# Works with OpenAI, Groq, Together, Ollama, etc.
# Leave AI_API_KEY empty to use the chatbot's basic fallback replies.
AI_API_KEY=

# Example free provider — Groq:
#   AI_API_KEY=gsk_your_key_here
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=llama-3.3-70b-versatile
#
# OpenAI:       AI_BASE_URL=https://api.openai.com/v1
#               AI_MODEL=gpt-4o-mini
# Together:     AI_BASE_URL=https://api.together.xyz/v1
#               AI_MODEL=meta-llama/Llama-3-70b
# Ollama (local): AI_BASE_URL=http://localhost:11434/v1
#               AI_MODEL=llama3   (no key needed)
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# --- Server ---
HOST=127.0.0.1
PORT=8000